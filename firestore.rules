rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Sales transactions
    match /sales/{saleId} {
      allow read: if true;
      allow write: if true;
    }

    // Customers khata accounts
    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }

    // Shop settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
